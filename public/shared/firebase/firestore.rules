rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isConnectedParent(studentUid) {
      return signedIn() &&
        (
          (resource != null && resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
          (exists(/databases/$(database)/documents/students/$(studentUid)) &&
           request.auth.uid in get(/databases/$(database)/documents/students/$(studentUid)).data.parentIds) ||
          exists(/databases/$(database)/documents/student_parent_connections/$(studentUid + '_' + request.auth.uid))
        );
    }

    function isConnectedTeacher(studentUid) {
      return signedIn() &&
        (
          (resource != null && resource.data.teacherIds != null && request.auth.uid in resource.data.teacherIds) ||
          (exists(/databases/$(database)/documents/students/$(studentUid)) &&
           request.auth.uid in get(/databases/$(database)/documents/students/$(studentUid)).data.teacherIds) ||
          exists(/databases/$(database)/documents/student_teacher_connections/$(studentUid + '_' + request.auth.uid))
        );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /students/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isConnectedParent(uid) ||
        isConnectedTeacher(uid) ||
        (resource != null && resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
        exists(/databases/$(database)/documents/student_parent_connections/$(uid + '_' + request.auth.uid))
      );

      allow create: if signedIn();
      allow update: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
      allow delete: if signedIn() && request.auth.uid == uid;

      match /tasks/{taskId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /notes/{noteId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /books/{bookId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /search_history/{searchId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow create, update: if signedIn() && request.auth.uid == uid;
      }

      match /exam_submissions/{examId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow write: if signedIn();
      }

      match /exam_drafts/{examId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /attendance/{attId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow write: if signedIn();
      }

      match /progress/{progressId} {
        allow read: if signedIn() && (request.auth.uid == uid || isConnectedParent(uid) || isConnectedTeacher(uid));
        allow write: if signedIn();
      }
    }

    match /parents/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /teachers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;

      match /assignments/{assignmentId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /exams/{examId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /announcements/{announcementId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if signedIn();

      match /{document=**} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /student_parent_connections/{connectionId} {
      allow read: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.parent_uid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        resource.data.student_uid == request.auth.uid
      );
      allow create: if signedIn() && (
        request.resource.data.parentUid == request.auth.uid ||
        request.resource.data.parent_uid == request.auth.uid ||
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.student_uid == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.parent_uid == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.parent_uid == request.auth.uid
      );
    }

    match /student_teacher_connections/{connectionId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
  }
}
