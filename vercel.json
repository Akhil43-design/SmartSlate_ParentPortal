{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/shared/(.*)",
      "dest": "/public/shared/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/assets/icons/icon-child-profile.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
